{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Digital Ghana product catalogue",
  "type": "object",
  "required": ["version", "domain", "dns", "controlPlane", "products"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "domain": { "const": "digitalghana.dev" },
    "dns": {
      "type": "object",
      "required": ["authoritativeProvider", "nameservers", "verifiedAt", "evidence"],
      "properties": {
        "authoritativeProvider": { "type": "string", "minLength": 1 },
        "nameservers": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "verifiedAt": { "type": "string", "format": "date" },
        "evidence": { "type": "string", "minLength": 1 },
        "wildcardResolution": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "controlPlane": {
      "type": "object",
      "required": ["github", "vercel", "render", "evidence"],
      "properties": {
        "github": {
          "type": "object",
          "required": ["authenticatedAccount", "remoteState"],
          "properties": {
            "authenticatedAccount": { "type": "string", "minLength": 1 },
            "remoteState": { "enum": ["missing", "configured"] },
            "remote": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "vercel": {
          "type": "object",
          "required": ["team", "domainRegistrar"],
          "properties": {
            "team": { "type": "string", "minLength": 1 },
            "domainRegistrar": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "render": {
          "type": "object",
          "required": ["workspace", "geoServicesFound"],
          "properties": {
            "workspace": { "type": "string", "minLength": 1 },
            "geoServicesFound": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "repository", "lifecycle", "order", "surfaces"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 2 },
          "repository": { "type": ["string", "null"] },
          "lifecycle": { "enum": ["proposed", "planning", "building", "beta", "stable", "externally_blocked", "retired"] },
          "order": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string" },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "hostname", "environment", "state", "canonical", "provider", "evidence"],
              "properties": {
                "kind": { "enum": ["umbrella", "web", "api", "sandbox", "console", "admin", "gateway"] },
                "hostname": { "type": "string", "pattern": "^([a-z0-9-]+\\.)*digitalghana\\.dev$" },
                "environment": { "enum": ["production", "staging", "preview"] },
                "state": { "enum": ["planned", "provisioning", "live", "redirect", "retired"] },
                "canonical": { "type": "boolean" },
                "provider": { "type": ["string", "null"] },
                "evidence": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
